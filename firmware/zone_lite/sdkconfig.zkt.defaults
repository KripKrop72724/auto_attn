# ZKT 2.7 platform profile, applied after sdkconfig.defaults for the ZKT family
# only. The Hikvision family keeps its own qualified profile.
#
# Every 2.6.16-2.6.23 field failure on SLICTOWER-3FL traced back to internal
# RAM: the 2.6.21 captures showed 323-3,915 B internal free while 6.1 MB of
# PSRAM was idle. TLS records already lived in PSRAM, so each AES-GCM record
# needed a fresh internal DMA bounce buffer, and those allocations failed.

# Software AES encrypts TLS records in place in PSRAM; hardware AES needed an
# internal DMA bounce buffer (up to 1,600 B) for every record.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# All mbedTLS allocations, including contexts and small handshake buffers,
# use PSRAM; nothing in TLS needs DMA once AES runs in software.
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# No code reads the peer certificate after the handshake.
# CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE is not set

# On ESP32-S3, IRAM and DRAM share internal SRAM. Wi-Fi hot paths in flash
# cost a little throughput and return internal RAM to the heap.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set

# At 100 Hz, pdMS_TO_TICKS(1) is zero ticks: those waits only yielded, which
# starved the idle tasks (IDLE watchdog reports on 2.6.15 storage_init).
# 1 kHz gives every millisecond wait a real tick.
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# uxTaskGetSystemState feeds per-task stack high-water marks to ADD.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
