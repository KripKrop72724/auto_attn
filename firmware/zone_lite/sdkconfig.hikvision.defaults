# ISAPI requires Digest authentication; ESP-IDF disables it by default.
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y

# Concurrent history/profile workers leave insufficient internal heap for TLS.
# Use the board's configured malloc policy (internal first, PSRAM fallback).
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Keep the qualified Hikvision memory policy unchanged; the 2.6.2 reserve
# adjustment applies only to the ZKT direct-ORDS candidate.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
