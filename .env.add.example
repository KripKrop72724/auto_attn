# Copy to .env.add on the deployment host. Never commit the real file.
ADD_POSTGRES_DB=attendance_devices
ADD_POSTGRES_USER=add_service
ADD_POSTGRES_PASSWORD=replace-with-a-long-random-value

ADD_ADMIN_USERNAME=StateHealthAdmin
# Generate with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash(input()))"
# Keep the value single-quoted because Docker Compose otherwise expands Argon2's dollar delimiters.
ADD_ADMIN_PASSWORD_HASH='replace-with-an-argon2id-hash'
ADD_ADMIN_COOKIE_SECURE=true

# Generate with Fernet.generate_key() and secrets.token_hex(32), respectively.
ADD_PII_FERNET_KEY=replace-with-a-fernet-key
ADD_PII_LOOKUP_KEY=replace-with-a-random-hmac-key

# Protected root used to derive a unique onboarding secret per ESP Wi-Fi MAC.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADD_FLEET_ROOT_SECRET=replace-with-a-protected-random-fleet-root
ADD_PUBLIC_DEVICE_WS_URL=wss://autoattn.slichealth.com/device/v2/stream

ADD_ORDS_BASE_URL=https://example.invalid/ords/example/raw_attn_capture_event
ADD_ORDS_USERNAME=replace-me
ADD_ORDS_PASSWORD=replace-me
# Direct Oracle membership proof for firmware receipts is bounded by the ORDS
# endpoint's 500-event contract.
ADD_ORDS_FIRMWARE_AUDIT_BATCH_SIZE=500
# Revalidate every Oracle-confirmed event at least once per day.
ADD_ORDS_MEMBERSHIP_REVERIFY_SECONDS=86400

# Enable only after every connector reports Zone Lite 2.1.11 or newer.
ADD_IDENTITY_SNAPSHOT_GATE_ENABLED=false

# Firmware OTA remains off until the Peshawar Secure Boot bootstrap and HIL
# acceptance are complete. The host path must be outside deploy workspaces and
# writable only by the protected firmware publication runner.
ADD_FIRMWARE_OTA_ENABLED=false
# Quarantined hardware validation is independent from national OTA. Enable it
# only with one exact ESP MAC and remove both values after HIL promotion.
ADD_FIRMWARE_HIL_ENABLED=false
ADD_FIRMWARE_HIL_TARGET_MAC=
ADD_FIRMWARE_STORE_PATH=/firmware
ADD_FIRMWARE_STORE_HOST_PATH=./.firmware-store
# Signed assignments must use this explicit HTTPS origin; never derive it from
# reverse-proxy request metadata.
ADD_FIRMWARE_PUBLIC_BASE_URL=https://autoattn.slichealth.com
ADD_FIRMWARE_DOWNLOAD_GRANT_SECONDS=900
# Base64 of the RSA-3072 public key only; never place a private key here.
ADD_FIRMWARE_SIGNING_PUBLIC_KEY_PEM_B64=

# Zone Lite 2.5.0 COMM Key recovery is deployed dark. The dedicated Fernet
# key must never reuse ADD_PII_FERNET_KEY. Enable reveal independently only
# after the audited break-glass procedure is approved.
ADD_COMM_KEY_MANAGEMENT_ENABLED=false
ADD_COMM_KEY_REVEAL_ENABLED=false
ADD_COMM_KEY_SECRET_FERNET_KEY=replace-with-a-separate-fernet-key
ADD_COMM_KEY_OPERATION_SECONDS=604800

# Physical USB provisioning stays dark until an immutable AVAILABLE factory
# bundle and both companion packages have passed destructive HIL. These values
# have no legacy-key fallback.
ADD_PROVISIONING_ENABLED=false
ADD_PROVISIONING_PAIRING_SECRET=replace-with-a-separate-random-pairing-secret
ADD_PROVISIONING_INTERNAL_TOKEN=replace-with-a-separate-random-internal-token
ADD_PROVISIONING_WORKER_URL=http://add-provisioner:8097
ADD_PROVISIONING_ARTIFACT_PATH=/provisioning-artifacts
ADD_PROVISIONING_ARTIFACT_SECONDS=900
ADD_PROVISIONING_SESSION_SECONDS=1800
ADD_PROVISIONING_PAIRING_SECONDS=300
ADD_PROVISIONING_COMPANION_MIN_VERSION=1.0.0
ADD_PROVISIONING_COMPANION_RELEASE_PATH=/companion-releases
ADD_PROVISIONING_COMPANION_RELEASE_PUBLIC_KEY_B64=
ADD_PROVISIONING_FACTORY_STORE_PATH=/factory-firmware
ADD_PROVISIONING_PUBLIC_WS_URL=wss://autoattn.slichealth.com/companion/v1/stream
ADD_FACTORY_FIRMWARE_STORE_HOST_PATH=./.factory-firmware-store
ADD_COMPANION_RELEASE_STORE_HOST_PATH=./.companion-releases
ADD_USER_INTEGRITY_INTERVAL_SECONDS=30
ADD_IDENTITY_SNAPSHOT_CAPTURE_TOLERANCE_SECONDS=5
ADD_IDENTITY_REPAIR_SLA_SECONDS=60

# ADD-owned source-of-truth reconciliation is deployed dark first. Enable it
# only after the matching Zone Lite firmware passes range-resume HIL.
ADD_RECONCILIATION_ENABLED=false
ADD_RECONCILIATION_SELF_HEALING_ENABLED=false
ADD_RECONCILIATION_DEVICE_CONCURRENCY=6
ADD_RECONCILIATION_CHUNK_RECORDS=100
ADD_RECONCILIATION_HISTORY_BACKLOG_PAUSE=10000
ADD_RECONCILIATION_HISTORY_BACKLOG_RESUME=5000

# Employee attendance repair rolls out in two independent stages. Preview is
# read-only; execution can be enabled only after the Oracle downstream adapter
# proves both the corrected employee/day projection and removal of stale output.
ADD_ATTENDANCE_REPAIR_PREVIEW_ENABLED=false
ADD_ATTENDANCE_REPAIR_EXECUTION_ENABLED=false
# The old multi-employee cohort candidate/prepare API remains off. Existing
# legacy jobs retain read, approval, recovery, control and evidence support.
ADD_ATTENDANCE_REPAIR_LEGACY_ADMISSION_ENABLED=false
ADD_ATTENDANCE_REPAIR_PREVIEW_SECONDS=900
ADD_ATTENDANCE_REPAIR_SOURCE_MAX_AGE_SECONDS=900
ADD_ATTENDANCE_REPAIR_MAX_EMPLOYEES=500
ADD_ATTENDANCE_REPAIR_MAX_EVENTS=250000
ADD_ATTENDANCE_REPAIR_ORACLE_BATCH_SIZE=100
ADD_ATTENDANCE_REPAIR_ORACLE_CONCURRENCY=2
# Dedicated ADD-only Oracle credential. It must not be the connector/fleet
# ADD_ORDS_USERNAME/ADD_ORDS_PASSWORD pair used for ordinary punch delivery.
ADD_ATTENDANCE_REPAIR_ORDS_USERNAME=replace-with-dedicated-repair-user
ADD_ATTENDANCE_REPAIR_ORDS_PASSWORD=replace-with-dedicated-repair-password
# Must remain at least twice ADD_ORDS_TIMEOUT_SECONDS (default 20 seconds).
ADD_ATTENDANCE_REPAIR_LEASE_SECONDS=90
ADD_ATTENDANCE_REPAIR_RETRY_LIMIT=12

# Optional Windows deployment-state override. The production default is protected ProgramData.
# ADD_DEPLOY_STATE_DIR=C:\ProgramData\StateLife\AttendanceDeviceDashboard

# Container capacity defaults for the production host. Docker Desktop/Engine must itself have
# at least 48 GB RAM, 24 logical CPUs and sufficient free disk available; host capacity is not
# automatically available when the Docker VM has a smaller ceiling.
ADD_POSTGRES_MEMORY_LIMIT=16g
ADD_POSTGRES_SHARED_BUFFERS=4GB
ADD_POSTGRES_EFFECTIVE_CACHE_SIZE=12GB
ADD_POSTGRES_MAINTENANCE_WORK_MEM=1GB
ADD_POSTGRES_SHM_SIZE=2gb
ADD_REDIS_MEMORY_LIMIT=2g
ADD_REDIS_MAXMEMORY=1gb
ADD_API_MEMORY_LIMIT=8g
ADD_PROVISIONER_MEMORY_LIMIT=4g
ADD_WEB_MEMORY_LIMIT=1g
ADD_WATCHDOG_MEMORY_LIMIT=256m

# Bound database waits so an exhausted or blocked database fails quickly instead of holding every
# HTTP worker until the reverse proxy returns 504. The API liveness probe recycles a truly wedged
# process after this many consecutive ten-second failures.
ADD_DATABASE_POOL_SIZE=20
ADD_DATABASE_MAX_OVERFLOW=20
ADD_DATABASE_POOL_TIMEOUT_SECONDS=5
ADD_DATABASE_CONNECT_TIMEOUT_SECONDS=5
ADD_DATABASE_STATEMENT_TIMEOUT_MS=30000
ADD_DATABASE_LOCK_TIMEOUT_MS=5000
ADD_SLOW_REQUEST_SECONDS=2
ADD_EVENT_LOOP_LAG_WARNING_SECONDS=1
ADD_LIVENESS_FAILURES_BEFORE_RESTART=3
ADD_WATCHDOG_INTERVAL_SECONDS=10
ADD_WATCHDOG_UNHEALTHY_OBSERVATIONS=1
ADD_WATCHDOG_RESTART_GRACE_SECONDS=30
ADD_WATCHDOG_RESTART_COOLDOWN_SECONDS=60
